# Copier en .env (jamais commité) : cp .env.example .env
# Valeurs de développement local uniquement. Ne jamais les réutiliser en déploiement.

# Postgres : superutilisateur, réservé à l'initialisation et à l'administration.
POSTGRES_USER=hypeclip
POSTGRES_PASSWORD=hypeclip-dev
POSTGRES_DB=hypeclip

# Un rôle par service, propriétaire de son schéma (<schéma>_svc).
IDENTITY_DB_PASSWORD=identity-dev
INGESTION_DB_PASSWORD=ingestion-dev
DETECTION_DB_PASSWORD=detection-dev
CLIP_DB_PASSWORD=clip-dev
JOBS_DB_PASSWORD=jobs-dev

REDIS_PASSWORD=redis-dev

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-dev

# Ports exposés sur 127.0.0.1, à changer en cas de conflit avec un service déjà lancé.
POSTGRES_PORT=5432
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITORING_PORT=8222
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
